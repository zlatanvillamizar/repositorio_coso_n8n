      ],
      "id": "6310956c-d9e3-452b-b600-28aa9b1737c2",
      "name": "Modulo TUTOR",
      "notesInFlow": false,
      "notes": "Reglas puras: decide y devuelve que hacer. No escribe ni notifica."
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// TutorBot · Normalizar respuesta del modulo\n// Punto unico de convergencia de los 7 modulos. Garantiza que, sin importar\n// que rama se ejecuto, exista siempre: mensaje, sesion, accion y fila de log.\n// Hay una copia de este nodo por rama: 'Normalizar REGISTRO', 'Normalizar MENU', etc.\n// Los nodos siguientes de cada rama leen del suyo, no de uno compartido.\n// ============================================================\nconst it = $input.first().json;\nconst cfg = $('Config').first().json;\n\n// ---- Rastro de la IA (si esta ejecucion paso por el interprete) ----\n// $('Nodo') lanza error si el nodo no se ejecuto en esta rama: se captura.\n// En el sub-workflow el contexto llega por 'Ejecutar modulo'; en un flujo unico\n// viene del nodo de validacion. Se prueban los dos y se ignora el que no exista.\nlet ia = null;\nfor (const nombre of ['Ejecutar modulo', 'Validar interpretacion IA']) {\n  try {\n    const j = $(nombre).first().json;\n    if (j && j.ia_usada) { ia = j; break; }\n  } catch (e) { /* ese nodo no existe en este workflow */ }\n}\n\nconst ACCIONES = ['sin_accion', 'crear_estudiante', 'crear_tutoria', 'actualizar_tutoria'];\nconst accion = ACCIONES.includes(it.accion) ? it.accion : 'sin_accion';\n\n// Telegram rechaza mensajes vacios y corta en 4096 caracteres\nlet mensaje = String(it.mensaje == null ? '' : it.mensaje).trim();\nif (!mensaje) mensaje = 'Ocurrio algo inesperado y no pude preparar una respuesta. Escribe /menu para reiniciar.';\n// El estudiante debe VER lo que el modelo entendio antes de que se reserve nada\nif (ia && ia.ia_aviso) mensaje = ia.ia_aviso + '\\n\\n' + mensaje;\n// Telegram interpreta el texto como HTML: hay que escapar estos tres caracteres.\n// Sin esto, un \"<\" en el texto rompe el envio entero con \"can't parse entities\".\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nmensaje = esc(mensaje);\nif (mensaje.length > 3900) mensaje = mensaje.slice(0, 3900) + '\\n\\n[mensaje recortado]';\n\nconst sesion = it.sesion || {\n  telegram_user: it.telegram_user, pantalla_actual: 'MENU', paso_actual: '0',\n  datos_parciales: '{}', actualizado_en: cfg.ahora_iso\n};\n\nconst tutoria = it.tutoria_row || null;\nconst estudiante = it.estudiante_row || null;\n\nlet entidad = 'sesion', id_entidad = String(it.telegram_user || '');\nif (tutoria)        { entidad = 'tutoria';    id_entidad = String(tutoria.id_tutoria || ''); }\nelse if (estudiante){ entidad = 'estudiante'; id_entidad = String(estudiante.id_estudiante || ''); }\n\n// Fila de LOG_EVENTOS: es la trazabilidad que pide la coordinacion\nconst log = {\n  id_evento: 'EV-' + String(cfg.ahora_iso).replace(/[^0-9]/g, '').slice(0, 14) + '-' + Math.floor(Math.random() * 9000 + 1000),\n  timestamp: cfg.ahora_iso,\n  telegram_user: String(it.telegram_user || ''),\n  evento: String(it.evento || 'interaccion'),\n  entidad: entidad,\n  id_entidad: id_entidad,\n  detalle: String(it.detalle == null ? '' : it.detalle).slice(0, 300)\n};\n// Auditoria del uso de IA: que se le mando, que devolvio y si se acepto\nif (ia) {\n  log.detalle = (log.detalle + ' | IA:' + ia.ia_intencion +\n    '/' + (ia.ia_materia || '-') + '/' + (ia.ia_fecha || '-') +\n    ' conf=' + ia.ia_confianza +\n    (ia.ia_fallo ? ' descartado=' + ia.ia_fallo : '') +\n    ' txt=\"' + String(ia.ia_texto_original || '').slice(0, 60) + '\"').slice(0, 300);\n}\n\nreturn [{\n  json: {\n    telegram_user: String(it.telegram_user || ''),\n    chat_id: String(it.chat_id || ''),\n    ruta: it.ruta || '', submodo: it.submodo || '',\n    mensaje: mensaje,\n    sesion: sesion,\n    accion: accion,\n    estudiante_row: estudiante,\n    tutoria_row: tutoria,\n    notificar: it.notificar && it.notificar.chat_id\n      ? Object.assign({}, it.notificar, { mensaje: esc(it.notificar.mensaje) })\n      : null,\n    ia_usada: !!ia,\n    ia_fallo: ia ? ia.ia_fallo : '',\n    log: log\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        192
      ],
      "id": "1cd4eef3-b4ee-4c26-87e8-867f0ddc0456",
      "name": "Normalizar respuesta",
      "notesInFlow": false,
      "notes": "Garantiza mensaje, sesion, accion y fila de log. Antepone lo que entendio la IA, si hubo."
    },
