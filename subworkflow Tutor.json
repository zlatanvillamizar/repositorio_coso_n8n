      "id": "d2943e1b-a4e2-4171-a8a2-ae8fd033ed6f",
      "name": "Contexto recibido",
      "notes": "Las hojas leidas siguen accesibles por nombre de nodo; este nodo devuelve el contexto como item de entrada del modulo."
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// TutorBot · Modulo TUTOR\n// Cierra el ciclo de vida: ASIGNADA -> CONFIRMADA -> FINALIZADA.\n// RN-12 un tutor solo puede operar sobre SUS tutorias (autorizacion)\n// RN-13 transiciones permitidas: confirmar solo desde ASIGNADA;\n//        finalizar solo desde ASIGNADA o CONFIRMADA\n// ============================================================\nconst ctx = $input.first().json;\nconst cfg = $('Config').first().json;\n\nfunction filas(nodo) {\n  try { return $(nodo).all().map(i => i.json).filter(r => r && Object.keys(r).length > 0); }\n  catch (e) { return []; }\n}\nconst tutorias = filas('Leer TUTORIAS').filter(t => String(t.id_tutoria || '') !== '');\n\nfunction salida(o) {\n  return [{ json: Object.assign({\n    telegram_user: ctx.telegram_user, chat_id: ctx.chat_id, ruta: ctx.ruta, submodo: ctx.submodo,\n    accion: 'sin_accion', estudiante_row: null, tutoria_row: null, notificar: null,\n    sesion: {\n      telegram_user: ctx.telegram_user, pantalla_actual: 'TUTOR', paso_actual: '0',\n      datos_parciales: '{}', actualizado_en: cfg.ahora_iso\n    },\n    evento: 'tutor', detalle: ''\n  }, o) }];\n}\n\nif (!ctx.es_tutor) {\n  return salida({\n    mensaje: 'Ese comando es solo para tutores registrados.\\n\\n' +\n             'Si eres tutor, pide a la coordinacion que registre tu ID de Telegram (' + ctx.telegram_user + ') en la hoja TUTORES.\\n' +\n             'Si eres estudiante, escribe /menu.',\n    evento: 'comando_tutor_no_autorizado',\n    detalle: ctx.telegram_user\n  });\n}\n\n// --- /mis : agenda del tutor ---\nif (ctx.submodo === 'mis') {\n  const mias = tutorias.filter(t =>\n    String(t.id_tutor) === String(ctx.id_tutor_emisor) &&\n    ['ASIGNADA', 'CONFIRMADA'].includes(String(t.estado || '').toUpperCase())\n  ).sort((a, b) => String(a.fecha + a.hora).localeCompare(String(b.fecha + b.hora))).slice(0, 15);\n\n  return salida({\n    mensaje: mias.length === 0\n      ? 'No tienes tutorias pendientes.'\n      : 'Tu agenda (' + mias.length + '):\\n\\n' + mias.map(t =>\n          '[' + String(t.estado).toUpperCase() + '] ' + t.materia + '\\n   ' + t.fecha + ' ' + t.hora + '-' + (t.hora_fin || '') +\n          '\\n   ' + (t.nombre_estudiante || t.id_estudiante) + '\\n   ' + t.id_tutoria\n        ).join('\\n\\n') + '\\n\\nUsa /confirmar CODIGO o /finalizar CODIGO (el numero de 10 digitos).',\n    evento: 'agenda_tutor',\n    detalle: mias.length + ' registros'\n  });\n}\n\n// --- /confirmar <id> y /finalizar <id> ---\nconst id = String(ctx.argumento || '').trim();\nif (!id) {\n  return salida({\n    mensaje: 'Falta el codigo de la tutoria. Ejemplo:\\n/' + ctx.submodo + ' 1234567890\\n\\nUsa /mis para ver tus codigos.',\n    evento: 'comando_incompleto'\n  });\n}\n\nconst fila = tutorias.find(t => String(t.id_tutoria).toUpperCase() === id.toUpperCase());\nif (!fila) {\n  return salida({ mensaje: 'No existe una tutoria con el codigo ' + id + '.', evento: 'tutoria_no_encontrada', detalle: id });\n}\n// RN-12\nif (String(fila.id_tutor) !== String(ctx.id_tutor_emisor)) {\n  return salida({\n    mensaje: 'Esa tutoria no esta asignada a ti, asi que no puedo modificarla.',\n    evento: 'operacion_no_autorizada',\n    detalle: id + ' pertenece a ' + fila.id_tutor\n  });\n}\n\nconst estadoActual = String(fila.estado || '').toUpperCase();\nconst nuevo = ctx.submodo === 'confirmar' ? 'CONFIRMADA' : 'FINALIZADA';\nconst permitidas = nuevo === 'CONFIRMADA' ? ['ASIGNADA'] : ['ASIGNADA', 'CONFIRMADA'];\n\n// RN-13\nif (!permitidas.includes(estadoActual)) {\n  return salida({\n    mensaje: 'No puedo pasar de ' + estadoActual + ' a ' + nuevo + '.\\n' +\n             'Transiciones validas: ASIGNADA -> CONFIRMADA -> FINALIZADA.',\n    evento: 'transicion_invalida',\n    detalle: id + ': ' + estadoActual + ' -> ' + nuevo\n  });\n}\n\nconst actualizada = Object.assign({}, fila, {\n  estado: nuevo,\n  fecha_actualizacion: cfg.ahora_iso,\n  motivo: nuevo === 'FINALIZADA' ? 'finalizada por el tutor' : ''\n});\ndelete actualizada.row_number;\n\nconst avisoEstudiante = nuevo === 'CONFIRMADA'\n  ? 'Buenas noticias: ' + fila.nombre_tutor + ' confirmo tu tutoria de ' + fila.materia +\n    '\\n' + fila.fecha + ' a las ' + fila.hora + '\\nCodigo: ' + fila.id_tutoria\n  : 'Tu tutoria de ' + fila.materia + ' del ' + fila.fecha + ' quedo FINALIZADA. Gracias por asistir.' +\n    '\\nCodigo: ' + fila.id_tutoria;\n\nreturn salida({\n  mensaje: 'Listo. La tutoria ' + fila.id_tutoria + ' quedo en estado ' + nuevo + '.\\n' +\n           fila.materia + ' · ' + fila.fecha + ' ' + fila.hora + ' · ' + (fila.nombre_estudiante || fila.id_estudiante) +\n           '\\n\\nYa avise al estudiante.',\n  accion: 'actualizar_tutoria',\n  tutoria_row: actualizada,\n  notificar: fila.telegram_user_estudiante ? {\n    chat_id: String(fila.telegram_user_estudiante), mensaje: avisoEstudiante\n  } : null,\n  evento: nuevo === 'CONFIRMADA' ? 'tutoria_confirmada' : 'tutoria_finalizada',\n  detalle: fila.id_tutoria\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
