    {
      "parameters": {
        "jsCode": "// ============================================================\n// TutorBot · Planificar acciones programadas\n// Se ejecuta cada hora. Decide, para cada tutoria vigente, si toca\n// (a) enviar recordatorio o (b) cerrarla automaticamente.\n//\n// IDEMPOTENCIA: el recordatorio solo sale si TUTORIAS.recordatorio_enviado\n// esta vacio, y se marca inmediatamente despues de enviarlo. El cierre solo\n// aplica a estados ASIGNADA/CONFIRMADA, asi que reejecutar el flujo no\n// repite ninguna accion. Si no hay nada que hacer, este nodo devuelve 0\n// items y el resto del workflow no se ejecuta.\n// ============================================================\nconst cfg = $('Config').first().json;\n\nconst HORAS_REC = Number(cfg.HORAS_RECORDATORIO || 24);\nconst GRACIA    = Number(cfg.MIN_GRACIA_CIERRE || 15);\nconst DUR       = Number(cfg.DURACION_MIN || 60);\nconst VIGENTES  = ['ASIGNADA', 'CONFIRMADA'];\n\n// Telegram interpreta el texto como HTML: hay que escapar estos tres caracteres.\n// Sin esto, un \"<\" o un guion bajo suelto rompe el envio con \"can't parse entities\".\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst aMin = h => { const m = /^(\\d{1,2}):(\\d{2})/.exec(String(h == null ? '' : h).trim()); return m ? Number(m[1]) * 60 + Number(m[2]) : null; };\nconst aDias = f => { const p = String(f).split('-').map(Number); return Date.UTC(p[0], p[1] - 1, p[2]) / 86400000; };\n\nfunction filas(nodo) {\n  try { return $(nodo).all().map(i => i.json).filter(r => r && Object.keys(r).length > 0); }\n  catch (e) { return []; }\n}\nconst tutorias = filas('Leer TUTORIAS').filter(t => String(t.id_tutoria || '') !== '');\nconst tutores  = filas('Leer TUTORES').filter(t => String(t.id_tutor || '') !== '');\n\nfunction minutosHasta(fecha, hora) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(fecha || ''))) return null;\n  const dias = aDias(fecha) - aDias(cfg.hoy);\n  const h = aMin(hora);\n  if (h === null) return null;\n  return dias * 1440 + (h - (aMin(cfg.hora_actual) || 0));\n}\n\nconst salida = [];\n\nfor (const t of tutorias) {\n  if (!VIGENTES.includes(String(t.estado || '').toUpperCase())) continue;\n\n  const faltanInicio = minutosHasta(t.fecha, t.hora);\n  if (faltanInicio === null) continue;   // fila incompleta: se ignora, no rompe el flujo\n  const horaFin = t.hora_fin || null;\n  const faltanFin = horaFin ? minutosHasta(t.fecha, horaFin) : faltanInicio + Number(t.duracion_min || DUR);\n\n  const tutor = tutores.find(x => String(x.id_tutor) === String(t.id_tutor));\n  const fila = Object.assign({}, t);\n  delete fila.row_number;\n\n  // (b) Cierre automatico: ya termino y sigue abierta\n  if (faltanFin !== null && faltanFin < -GRACIA) {\n    salida.push({\n      json: {\n        tipo: 'finalizar',\n        id_tutoria: String(t.id_tutoria),\n        fila: Object.assign({}, fila, {\n          estado: 'FINALIZADA',\n          fecha_actualizacion: cfg.ahora_iso,\n          motivo: 'cierre automatico: el horario ya transcurrio'\n        }),\n        chat_estudiante: String(t.telegram_user_estudiante || ''),\n        msg_estudiante: 'Tu tutoria de ' + t.materia + ' del ' + t.fecha + ' ' + t.hora +\n                        ' quedo FINALIZADA.\\nCodigo: ' + t.id_tutoria +\n                        '\\n\\nSi no pudiste asistir, avisa a la coordinacion academica.',\n        chat_tutor: String((tutor && tutor.telegram_chat_id) || ''),\n        msg_tutor: '',\n        log: {\n          id_evento: 'EV-' + String(cfg.ahora_iso).replace(/[^0-9]/g, '').slice(0, 14) + '-' + Math.floor(Math.random() * 9000 + 1000),\n          timestamp: cfg.ahora_iso, telegram_user: 'sistema',\n          evento: 'cierre_automatico', entidad: 'tutoria', id_entidad: String(t.id_tutoria),\n          detalle: 'estado previo ' + t.estado + ' · ' + t.fecha + ' ' + t.hora\n        }\n      }\n    });\n    continue;\n  }\n\n  // (a) Recordatorio: dentro de la ventana, futura y no enviado aun\n  const yaEnviado = String(t.recordatorio_enviado || '').trim() !== '';\n  if (!yaEnviado && faltanInicio > 0 && faltanInicio <= HORAS_REC * 60) {\n    salida.push({\n      json: {\n        tipo: 'recordatorio',\n        id_tutoria: String(t.id_tutoria),\n        fila: Object.assign({}, fila, {\n          recordatorio_enviado: cfg.ahora_iso,\n          fecha_actualizacion: cfg.ahora_iso\n        }),\n        chat_estudiante: String(t.telegram_user_estudiante || ''),\n        msg_estudiante: 'Recordatorio de tutoria\\n\\n' +\n                        'Materia: ' + t.materia + '\\n' +\n                        'Tutor: ' + (t.nombre_tutor || '') + '\\n' +\n                        'Cuando: ' + t.fecha + ' a las ' + t.hora + '\\n' +\n                        'Estado: ' + t.estado + '\\n' +\n                        'Codigo: ' + t.id_tutoria + '\\n\\n' +\n                        'Si no puedes asistir, escribeme /menu y usa la opcion 3 para cancelar.',\n        chat_tutor: String((tutor && tutor.telegram_chat_id) || ''),\n        msg_tutor: 'Recordatorio: tienes tutoria de ' + t.materia + ' con ' +\n                   (t.nombre_estudiante || t.id_estudiante) + ' el ' + t.fecha + ' a las ' + t.hora +\n                   '.\\nCodigo: ' + t.id_tutoria,\n        log: {\n          id_evento: 'EV-' + String(cfg.ahora_iso).replace(/[^0-9]/g, '').slice(0, 14) + '-' + Math.floor(Math.random() * 9000 + 1000),\n          timestamp: cfg.ahora_iso, telegram_user: 'sistema',\n          evento: 'recordatorio_enviado', entidad: 'tutoria', id_entidad: String(t.id_tutoria),\n          detalle: 'faltaban ' + faltanInicio + ' minutos'\n        }\n      }\n    });\n  }\n}\n\n// Ultimo paso: los textos van a Telegram en modo HTML\nfor (const it of salida) {\n  it.json.msg_estudiante = esc(it.json.msg_estudiante);\n  it.json.msg_tutor = esc(it.json.msg_tutor);\n}\n\nreturn salida;\n"
      },
      "id": "d77cb6c1-b505-4e1c-98ea-3aaa375bdba2",
      "name": "Planificar acciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        272
      ],
      "notes": "Devuelve 0..n items. Si no hay nada que hacer, ningun nodo posterior se ejecuta."
